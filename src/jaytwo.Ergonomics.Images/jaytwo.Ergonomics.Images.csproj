<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net6.0</TargetFrameworks>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Description>Ergonomic resize and rotation for still images, on NetVips.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jakegough-jaytwo/jaytwo.Ergonomics.Images</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jakegough-jaytwo/jaytwo.Ergonomics.Images</RepositoryUrl>
    <PackageTags>images;resize;rotate;crop;libvips;NetVips;jpeg;png;webp;heic;jaytwo;ergonomics</PackageTags>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- SourceLink: step-into support and a symbols package. The .NET 8+ SDK supplies the GitHub provider. -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="jaytwo.Ergonomics.Images.Tests" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" Link="README.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NetVips" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Probes\heic-probe.heic">
      <LogicalName>jaytwo.Ergonomics.Images.Probes.heic</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Probes\avif-probe.avif">
      <LogicalName>jaytwo.Ergonomics.Images.Probes.avif</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
