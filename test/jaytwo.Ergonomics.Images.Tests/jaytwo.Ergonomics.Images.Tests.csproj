<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net6.0</TargetFrameworks>
    <!-- Local dev references NetVips.Native. Docker and production hosts set this false and use system libvips. -->
    <UseBundledLibVips Condition="'$(UseBundledLibVips)' == ''">true</UseBundledLibVips>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\jaytwo.Ergonomics.Images\jaytwo.Ergonomics.Images.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseBundledLibVips)' == 'true'">
    <PackageReference Include="NetVips.Native" Version="8.18.6" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\fixtures\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <LinkBase>fixtures</LinkBase>
    </None>
    <None Include="..\..\src\jaytwo.Ergonomics.Images\Probes\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <LinkBase>probes</LinkBase>
    </None>
  </ItemGroup>

</Project>
